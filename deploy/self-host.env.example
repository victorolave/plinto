# Plinto self-host configuration.
#
# Quick start:
#   cp deploy/self-host.env.example .env
#   <fill in every REPLACE_ME below>
#   docker compose up -d --build
#
# All placeholders below are fake. Nothing in this file is a real secret —
# generate your own values (e.g. `openssl rand -hex 32`) before deploying.

# ---------------------------------------------------------------------------
# Public URL (documentation only — read this before filling in anything else)
# ---------------------------------------------------------------------------

# The externally reachable base URL of your Plinto instance, e.g.
# https://plinto.example.com or http://203.0.113.10:8080 for a bare-IP,
# no-TLS deployment. Plinto does NOT read this variable directly — it exists
# here so WEB_ORIGIN and OIDC_REDIRECT_URI below have one place to derive
# from. Set those two explicitly to match it; nothing derives them for you.
PLINTO_PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# postgres
# ---------------------------------------------------------------------------

# Credentials for the bundled Postgres container. Must match the credentials
# embedded in DATABASE_URL below — these three bootstrap the database on
# first start, DATABASE_URL is what the api container actually connects with.
POSTGRES_USER=plinto
POSTGRES_PASSWORD=REPLACE_ME_with_a_strong_password
POSTGRES_DB=plinto

# ---------------------------------------------------------------------------
# api (@plinto/api)
# ---------------------------------------------------------------------------

# Connection string the api container uses. Host "postgres" is the compose
# service name, not a real hostname — leave it as-is unless you point at an
# external database instead of the bundled one. User/password/db here must
# match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
DATABASE_URL=postgresql://plinto:REPLACE_ME_with_a_strong_password@postgres:5432/plinto

# Shared secret the web container sends on every server-to-server call so
# the api can trust the caller. Generate with `openssl rand -hex 32`. Read
# by BOTH the api and web containers (env_file applies this same file to
# both) — there is deliberately only one line for it, not one per service.
INTERNAL_API_KEY=REPLACE_ME_with_a_long_random_value

# Signs and verifies session tokens. Generate with `openssl rand -hex 32`.
# Read by BOTH the api and web containers — they must agree on this value or
# every session is rejected, which is guaranteed here by there being only
# one line for it.
JWT_SECRET=REPLACE_ME_with_a_long_random_value

# Must equal PLINTO_PUBLIC_URL above. Used for the api's CORS allow-list.
WEB_ORIGIN=http://localhost:8080

# Read by both containers.
NODE_ENV=production

# In-process job scheduler (nightly obligations backfill). docker-compose.yml
# already defaults this to "true" for the api service — self-host is
# single-replica, so that one instance is meant to own it. Uncomment only to
# force it off (e.g. a temporary read-only standby).
# JOBS_SCHEDULER_ENABLED=false

# Standard cron expression, evaluated in JOBS_TIMEZONE below.
JOBS_CRON=0 6 * * *

# IANA timezone name the cron expression above is evaluated in.
JOBS_TIMEZONE=America/Bogota

# How many months ahead of "today" the scheduler generates obligations for.
JOBS_HORIZON_MONTHS=3

# ---------------------------------------------------------------------------
# web (@plinto/web)
# ---------------------------------------------------------------------------
#
# INTERNAL_API_KEY, JWT_SECRET and NODE_ENV are also read by web — see the
# api section above, they are not repeated here.

# Your OIDC provider's issuer URL (e.g. https://your-tenant.auth0.com/,
# https://accounts.google.com, your Keycloak realm URL, ...).
OIDC_ISSUER_URL=https://REPLACE_ME.example.com

# Client id/secret registered with that provider for this deployment.
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME

# Must be registered on the OIDC provider EXACTLY as written here, and must
# be `${PLINTO_PUBLIC_URL}/callback` — e.g. if PLINTO_PUBLIC_URL above is
# https://plinto.example.com, this is https://plinto.example.com/callback.
OIDC_REDIRECT_URI=http://localhost:8080/callback

# GOTCHA: leaving this at "true" (or unset while NODE_ENV=production, which
# defaults to secure) on a plain-HTTP deployment makes the browser silently
# refuse to store the session cookie — you'll see a login that appears to
# succeed and then immediately bounces back to /login. Set this to "false"
# for any self-host that is not yet behind HTTPS, and back to "true" the
# moment it is (see the TLS section of deploy/nginx/default.conf).
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# docker-compose.yml itself (not read by either application image)
# ---------------------------------------------------------------------------

# Host port nginx is published on. http://localhost:${PLINTO_HTTP_PORT} is
# where you open the app.
PLINTO_HTTP_PORT=8080

# Tag applied to the images docker-compose.yml builds. Bump this alongside a
# git tag when you cut a release; "local" is fine for building from source.
PLINTO_VERSION=local
