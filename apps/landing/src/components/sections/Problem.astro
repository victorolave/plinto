---
// "02 · El problema" — the broken spreadsheet, the kitchen-table photo,
// and the three problem statements.
//
// `<image-slot>` (the design's placeholder for a missing image-slot.js
// tool script) becomes a plain lazy `<img>` here, filling its relative
// wrapper the way the design's `fit="cover"` did.
import { getDictionary, type Locale } from '../../i18n'
import { getLandingContent } from '../../data/landing-content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale).landing
const { sheet, probs } = getLandingContent(locale)
const coverImg = 'position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;'
---

<!-- ================= DESKTOP ================= -->
<div class="hidden lg:block">
<section style="padding:104px 40px; display:grid; grid-template-columns:repeat(12,1fr); column-gap:32px; row-gap:64px; border-top:2px solid var(--rule-strong);">
  <div style="grid-column:1 / span 4;">
    <span class="plinto-eyebrow" style="margin-bottom:24px;">02 · {t.prob_eyebrow}</span>
    <h2 style="font-size:48px; line-height:1.04; letter-spacing:-0.035em; font-weight:500; color:var(--text-strong); margin:0; text-wrap:balance;">{t.prob_title}</h2>
  </div>
  <!-- spreadsheet composition -->
  <div style="grid-column:6 / span 7; border:1px solid var(--border-hair); background:var(--surface-card); font-family:var(--font-mono); font-size:13px; color:var(--text-muted);">
    <div style="display:grid; grid-template-columns:40px 1.6fr 1fr 1fr 1fr; border-bottom:1px solid var(--border-hair); background:var(--surface-inset);">
      <div style="padding:8px 10px; border-right:1px solid var(--border-hair);"></div>
      <div style="padding:8px 10px; border-right:1px solid var(--border-hair);">A</div>
      <div style="padding:8px 10px; border-right:1px solid var(--border-hair);">B</div>
      <div style="padding:8px 10px; border-right:1px solid var(--border-hair);">C</div>
      <div style="padding:8px 10px;">D</div>
    </div>
    {sheet.map((r, i) => (
      <div data-reveal style={`--reveal-i:${i}; display:grid; grid-template-columns:40px 1.6fr 1fr 1fr 1fr; border-bottom:1px solid var(--border-hair);`}>
        <div style="padding:8px 10px; border-right:1px solid var(--border-hair); background:var(--surface-inset);">{r.n}</div>
        <div style="padding:8px 10px; border-right:1px solid var(--border-hair); color:var(--text-body); font-family:var(--font-sans);">{r.a}</div>
        <div style="padding:8px 10px; border-right:1px solid var(--border-hair); text-align:right;">{r.b}</div>
        <div data-reveal style={`--reveal-i:${sheet.length + i}; padding:8px 10px; border-right:1px solid var(--border-hair); color:${r.cColor}; font-family:var(--font-sans);`}>{r.c}</div>
        <div style="padding:8px 10px; color:var(--text-disabled);">{r.d}</div>
      </div>
    ))}
    <div data-reveal style={`--reveal-i:${sheet.length * 2}; padding:10px 12px; display:flex; justify-content:space-between; font-size:12px; letter-spacing:.08em; text-transform:uppercase;`}>
      <span>{t.sheet_file}</span><span style="color:var(--text-accent);">{t.sheet_edited}</span>
    </div>
  </div>
  <div data-scrub="photo" style="grid-column:1 / span 12; height:520px; position:relative;">
    <img src="/photos/planilla-mesa.jpg" alt={t.photo_1} loading="lazy" width="1600" height="1066" style={coverImg} />
  </div>
  <div style="grid-column:1 / span 12; display:grid; grid-template-columns:repeat(3,1fr); column-gap:32px;">
    {probs.map((p, i) => (
      <div data-reveal style={`--reveal-i:${i}; border-top:1px solid var(--rule-strong); padding-top:20px; display:flex; flex-direction:column; gap:20px;`}>
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-strong);"><path d={p.p1}></path><path d={p.p2}></path><path d={p.p3}></path><path d={p.p4}></path></svg>
          <span class="plinto-money" style="font-size:13px; color:var(--text-muted);">{p.n}</span>
        </div>
        <p style="font-size:28px; line-height:1.15; letter-spacing:-0.02em; font-weight:500; color:var(--text-strong); margin:0;">{p.text}</p>
      </div>
    ))}
  </div>
</section>
</div>

<!-- ================= MOBILE ================= -->
<div class="lg:hidden">
<section style="padding:56px 20px; border-top:2px solid var(--rule-strong); display:flex; flex-direction:column; gap:32px;">
  <div>
    <span class="plinto-eyebrow" style="margin-bottom:16px;">02 · {t.prob_eyebrow}</span>
    <h2 style="font-size:32px; line-height:1.05; letter-spacing:-0.03em; font-weight:500; color:var(--text-strong); margin:0;">{t.prob_title}</h2>
  </div>
  <div data-scrub="photo" style="height:240px; position:relative;">
    <img src="/photos/planilla-mesa.jpg" alt={t.photo_1} loading="lazy" width="1600" height="1066" style={coverImg} />
  </div>
  <div style="display:flex; flex-direction:column; border-bottom:1px solid var(--rule-hair);">
    {probs.map((p, i) => (
      <div data-reveal style={`--reveal-i:${i}; display:flex; gap:16px; align-items:flex-start; padding:16px 0; border-top:1px solid var(--rule-hair);`}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-strong); flex:none; margin-top:2px;"><path d={p.p1}></path><path d={p.p2}></path><path d={p.p3}></path><path d={p.p4}></path></svg>
        <p style="font-size:20px; line-height:1.25; letter-spacing:-0.02em; font-weight:500; color:var(--text-strong); margin:0;">{p.text}</p>
      </div>
    ))}
  </div>
</section>

</div>
