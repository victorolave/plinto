---
// "06 · Tus datos" — the family-at-the-table photo and the six data
// guarantees.
import { getDictionary, type Locale } from '../../i18n'
import { getLandingContent } from '../../data/landing-content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale).landing
const { dataFacts } = getLandingContent(locale)
const coverImg = 'position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;'
---

<!-- ================= DESKTOP ================= -->
<div class="hidden lg:block">
<section id="data" style="padding:104px 40px; border-top:2px solid var(--rule-strong); display:grid; grid-template-columns:repeat(12,1fr); column-gap:32px; row-gap:64px;">
  <div style="grid-column:1 / span 7;">
    <span class="plinto-eyebrow" style="margin-bottom:24px;">06 · {t.data_eyebrow}</span>
    <h2 data-reveal style="--reveal-i:0; font-size:64px; line-height:1.0; letter-spacing:-0.035em; font-weight:500; color:var(--text-strong); margin:0; max-width:18ch; text-wrap:balance;">{t.data_title}</h2>
  </div>
  <div data-scrub="photo" style="grid-column:8 / span 5; height:360px; position:relative;">
    <img src="/photos/familia-mesa.jpg" alt={t.photo_2} loading="lazy" width="1600" height="1066" style={coverImg} />
  </div>
  <div style="grid-column:1 / span 12; display:grid; grid-template-columns:repeat(6,1fr); column-gap:32px;">
    {dataFacts.map((f, i) => (
      <div data-reveal style={`--reveal-i:${i + 1}; border-top:1px solid var(--rule-strong); padding-top:16px; display:flex; flex-direction:column; gap:16px;`}>
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-strong);"><path d={f.p1}></path><path d={f.p2}></path><path d={f.p3}></path><path d={f.p4}></path></svg>
          <span class="plinto-money" style="font-size:13px; color:var(--text-muted);">{f.n}</span>
        </div>
        <p style="font-size:16px; font-weight:500; line-height:1.3; letter-spacing:-0.01em; color:var(--text-strong); margin:0;">{f.text}</p>
      </div>
    ))}
  </div>
</section>
</div>

<!-- ================= MOBILE ================= -->
<div class="lg:hidden">
<section style="padding:56px 20px; border-top:2px solid var(--rule-strong); display:flex; flex-direction:column; gap:28px;">
  <div>
    <span class="plinto-eyebrow" style="margin-bottom:16px;">06 · {t.data_eyebrow}</span>
    <h2 data-reveal style="--reveal-i:0; font-size:36px; line-height:1.02; letter-spacing:-0.035em; font-weight:500; color:var(--text-strong); margin:0;">{t.data_title}</h2>
  </div>
  <div data-scrub="photo" style="height:240px; position:relative;">
    <img src="/photos/familia-mesa.jpg" alt={t.photo_2} loading="lazy" width="1600" height="1066" style={coverImg} />
  </div>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px 20px;">
    {dataFacts.map((f, i) => (
      <div data-reveal style={`--reveal-i:${i + 1}; border-top:1px solid var(--rule-strong); padding-top:12px; display:flex; flex-direction:column; gap:10px;`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-strong);"><path d={f.p1}></path><path d={f.p2}></path><path d={f.p3}></path><path d={f.p4}></path></svg>
        <p style="font-size:14px; font-weight:500; line-height:1.3; color:var(--text-strong); margin:0;">{f.text}</p>
      </div>
    ))}
  </div>
</section>

</div>
