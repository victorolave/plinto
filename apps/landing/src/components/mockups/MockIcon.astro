---
/**
 * Static line-icon set for the app mockups. Every path below is copied
 * verbatim from apps/web/src/components/ui/icons.tsx (Lucide-style, 2px
 * stroke, round caps, 24x24 viewBox) so the mockups use the exact same
 * marks as the real app — just as plain inline SVG instead of a React
 * component, since these pages ship no client JS.
 */
export type MockIconName =
  | 'home'
  | 'wallet'
  | 'list'
  | 'target'
  | 'trendDown'
  | 'card'
  | 'tag'
  | 'settings'
  | 'helpCircle'
  | 'plus'
  | 'briefcase'
  | 'cart'
  | 'chevronRight'
  | 'search'
  | 'bank'
  | 'cash'
  | 'menu'
  | 'logOut'
  | 'pencil'

interface Props {
  name: MockIconName
  size?: number
  stroke?: number
  class?: string
}

const { name, size = 20, stroke = 2, class: className } = Astro.props
---

{
  name === 'home' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={stroke}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class={className}
