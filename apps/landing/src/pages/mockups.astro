---
// DEV-ONLY page: renders the four app-mockup components (AppShell,
// MockTransactions, MockObligations, MockPhone) stacked so they can be
// checked by eye. Delete this file before publishing the landing — it is
// scaffolding for building the mockups, not a real page.
import BaseLayout from '../layouts/BaseLayout.astro'
import AppShell from '../components/mockups/AppShell.astro'
import MockTransactions from '../components/mockups/MockTransactions.astro'
import MockObligations from '../components/mockups/MockObligations.astro'
import MockPhone from '../components/mockups/MockPhone.astro'
import { getDictionary } from '../i18n'

const locale = 'es' as const
const t = getDictionary(locale)
---

<BaseLayout title="Mockups (dev)" description="Internal preview of the app mockups.">
  <main class="mockups-review">
    <p class="mockups-review-note">
      Página de desarrollo — se borra antes de publicar la landing.
    </p>

    <section>
      <h2>AppShell + MockTransactions</h2>
      <AppShell
        locale={locale}
        active="transactions"
        title={t.mockups.shell.title.transactions}
        subtitle={t.mockups.shell.subtitle.transactions}
        frameHeight={1180}
      >
        <MockTransactions locale={locale} />
      </AppShell>
    </section>

    <section>
      <h2>AppShell + MockObligations</h2>
      <AppShell
        locale={locale}
        active="obligations"
        title={t.mockups.shell.title.obligations}
        subtitle={t.mockups.shell.subtitle.obligations}
        frameHeight={780}
      >
        <MockObligations locale={locale} />
      </AppShell>
    </section>

    <section>
      <h2>MockPhone</h2>
      <div class="mockups-review-phone">
        <MockPhone locale={locale} />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .mockups-review {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 32px 24px 96px;
    background: #ececec;
  }
  .mockups-review-note {
    font-family: monospace;
    font-size: 13px;
    color: #900;
  }
  .mockups-review h2 {
    font-family: sans-serif;
    font-size: 14px;
    color: #444;
    margin: 0 0 12px;
  }
  .mockups-review-phone {
    max-width: 390px;
  }
</style>
