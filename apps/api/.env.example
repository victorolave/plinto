# Plinto Environment Variables Example
# Copy this file to .env and fill in the actual values

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=3001

# Note: OIDC_* variables are NOT used by the API. The OIDC flow lives entirely
# in the web BFF (see ADR 0003); the API only trusts a pre-validated identity
# via the internal key below. OIDC config belongs in apps/web's env.

# ============================================
# Internal API Security
# ============================================
# Secret key for internal API communication between Web and API
# Generate a strong random string (e.g., openssl rand -base64 32)
INTERNAL_API_KEY=change-me-to-a-strong-random-key

# ============================================
# JWT Configuration
# ============================================
# Secret key for signing and verifying internal Plinto JWT tokens
# Must be the same in both Web and API applications
# Generate a strong random string (e.g., openssl rand -base64 64)
JWT_SECRET=change-me-to-a-strong-random-secret-minimum-32-characters

# ============================================
# Database
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/plinto

# ============================================
# Web Application (Next.js)
# ============================================
# Public API base URL (accessible from browser)
# Use full URL for production, relative path for same-origin
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# ============================================
# API Application (NestJS)
# ============================================
# Web origin for CORS configuration
WEB_ORIGIN=http://localhost:3000
