datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  idpSub    String   @unique @map("idp_sub")
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Tenant {
  id           String       @id @default(uuid())
  name         String
  baseCurrency String       @default("COP") @map("base_currency")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  memberships  Membership[]
  sessions     Session[]
  auditEvents  AuditEvent[]
  accounts     Account[]
  transactions Transaction[]
  transfers    Transfer[]
  recurringRules RecurringTransactionRule[]
  recurringExecutions RecurringTransactionExecution[]
  categories   Category[]
  obligationInstances ObligationInstance[]
  obligationPayments  ObligationPayment[]

  @@map("tenants")
}

model Account {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  name       String
  type       AccountType
  currency   String
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  archivedAt DateTime?   @map("archived_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
  transfersOut Transfer[]    @relation("TransferSource")
  transfersIn  Transfer[]    @relation("TransferDestination")
  recurringRules RecurringTransactionRule[]

  @@index([tenantId])
  @@index([tenantId, archivedAt])
  @@map("accounts")
}

model Membership {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  userId    String         @map("user_id")
  role      MembershipRole @default(owner)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@map("memberships")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tenantId   String?  @map("tenant_id")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime? @map("last_seen_at")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("sessions")
}

model AuditEvent {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  actorUserId   String?     @map("actor_user_id")
  action        String
  resourceType  String      @map("resource_type")
  resourceId    String?     @map("resource_id")
  source        AuditSource @default(manual)
  correlationId String      @map("correlation_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  metadata      Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("audit_events")
}

model Transaction {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  accountId   String          @map("account_id")
  type        TransactionType
  amountMinor Int             @map("amount_minor")
  currency    String
  description String?
  occurredAt  DateTime        @map("occurred_at")
  transferId  String?         @map("transfer_id")
  categoryId  String?         @map("category_id")
  source      TransactionSource @default(manual)
  recurringRuleId String?     @map("recurring_rule_id")
  recurringPeriod String?     @map("recurring_period")
  idempotencyKey String?      @map("idempotency_key")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  account  Account  @relation(fields: [accountId], references: [id])
  transfer Transfer? @relation(fields: [transferId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule RecurringTransactionRule? @relation(fields: [recurringRuleId], references: [id])
  recurringExecution RecurringTransactionExecution?
  obligationPayment ObligationPayment?

  @@index([tenantId])
  @@index([accountId])
  @@index([transferId])
  @@index([recurringRuleId])
  @@index([tenantId, source])
  @@index([tenantId, categoryId])
  @@map("transactions")
}

model RecurringTransactionRule {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  accountId String      @map("account_id")
  name      String
  type      TransactionType
  amountMinor Int       @map("amount_minor")
  currency  String
  frequency RecurringTransactionFrequency @default(monthly)
  dayOfMonth Int        @map("day_of_month")
  startDate DateTime    @map("start_date")
  status    RecurringRuleStatus @default(active)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  account      Account     @relation(fields: [accountId], references: [id])
  transactions Transaction[]
  executions   RecurringTransactionExecution[]
  obligationInstances ObligationInstance[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("recurring_transaction_rules")
}

model RecurringTransactionExecution {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  ruleId    String      @map("rule_id")
  period    String
  idempotencyKey String  @map("idempotency_key")
  transactionId String   @unique @map("transaction_id")
  status    RecurringExecutionStatus @default(success)
  jobId     String?     @map("job_id")
  createdAt DateTime    @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  rule        RecurringTransactionRule @relation(fields: [ruleId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@unique([ruleId, period])
  @@index([tenantId])
  @@map("recurring_transaction_executions")
}

/// One obligation for one period: what the household is expected to pay, and
/// when. Deliberately stores only facts — expected amount, due date, origin.
/// The lifecycle state (pending / partial / paid / overdue) is DERIVED from
/// the linked payments and the due date, never stored, so it cannot contradict
/// the payments that back it and no job is needed to age instances.
model ObligationInstance {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  sourceType          ObligationSourceType @map("source_type")
  recurringRuleId     String?  @map("recurring_rule_id")
  period              String
  dueDate             DateTime @map("due_date")
  name                String
  expectedAmountMinor Int      @map("expected_amount_minor")
  currency            String
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant        Tenant                    @relation(fields: [tenantId], references: [id])

  /// Restrict is explicit because Prisma would otherwise infer SetNull for an
  /// optional relation, and nulling `recurringRuleId` violates the
  /// `obligation_instances_source_matches_reference` CHECK, which demands a rule
  /// reference whenever `sourceType` is `recurring_rule`. Rules are archived and
  /// never deleted, so this never fires — it is stated so the schema agrees with
  /// the migration and `migrate dev` reports no drift to "repair".
  recurringRule RecurringTransactionRule? @relation(fields: [recurringRuleId], references: [id], onDelete: Restrict)
  payments      ObligationPayment[]

  /// Idempotency of generation. Postgres treats NULLs as distinct, so this
  /// blocks a second instance for the same (rule, period) while still allowing
  /// any number of one-off obligations inside the same period.
  @@unique([recurringRuleId, period])
  @@index([tenantId, period])
  @@map("obligation_instances")
}

/// Links a transaction to the obligation it pays. Several payments may settle
/// one obligation (rent paid in two transfers), but `transactionId` is unique
/// across the whole table, which is what makes "a transaction cannot reconcile
/// two obligations" a guarantee of the engine rather than a check somebody has
/// to remember to write.
model ObligationPayment {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  obligationInstanceId String   @map("obligation_instance_id")
  transactionId        String   @unique @map("transaction_id")
  createdAt            DateTime @default(now()) @map("created_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  obligationInstance ObligationInstance @relation(fields: [obligationInstanceId], references: [id])
  transaction        Transaction        @relation(fields: [transactionId], references: [id])

  @@unique([obligationInstanceId, transactionId])
  @@index([tenantId])
  @@index([obligationInstanceId])
  @@map("obligation_payments")
}

model Transfer {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  sourceAccountId      String    @map("source_account_id")
  destinationAccountId String    @map("destination_account_id")
  sourceAmountMinor    Int       @map("source_amount_minor")
  destinationAmountMinor Int     @map("destination_amount_minor")
  sourceCurrency       String    @map("source_currency")
  destinationCurrency  String    @map("destination_currency")
  fxRate               Decimal?  @map("fx_rate") @db.Decimal(20, 8)
  feeMinor             Int?      @map("fee_minor")
  rateSource           String?   @map("rate_source")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  sourceAccount      Account       @relation("TransferSource", fields: [sourceAccountId], references: [id])
  destinationAccount Account       @relation("TransferDestination", fields: [destinationAccountId], references: [id])
  transactions       Transaction[]

  @@index([tenantId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@map("transfers")
}

model Category {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  name      String
  type      TransactionType
  color     String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]

  @@index([tenantId])
  @@map("categories")
}

enum TransactionType {
  income
  expense
}

enum TransactionSource {
  manual
  job
}

enum RecurringTransactionFrequency {
  monthly
}

/// Single lifecycle state per rule. Replaces the former `active` boolean so
/// that "paused" and "archived" cannot be asserted at the same time, and so a
/// rule may only materialize money under one predicate: status = 'active'.
enum RecurringRuleStatus {
  active
  paused
  archived
}

enum RecurringExecutionStatus {
  success
}

/// Origin of an obligation instance. PRD-007 will add `debt_schedule` together
/// with its own nullable foreign key; a CHECK constraint keeps the declared
/// origin and the populated reference in agreement, so "exactly one origin" is
/// enforced by the database rather than by convention.
enum ObligationSourceType {
  recurring_rule
  manual
}

enum MembershipRole {
  owner
  member
  viewer
}

enum AccountType {
  cash
  bank
  credit
  savings
}

enum AuditSource {
  manual
  job
  import
}
