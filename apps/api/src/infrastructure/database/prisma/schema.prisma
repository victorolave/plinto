datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  idpSub    String   @unique @map("idp_sub")
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]
  invitationsSent Invitation[] @relation("InvitationInviter")

  @@map("users")
}

model Tenant {
  id           String       @id @default(uuid())
  name         String
  baseCurrency String       @default("COP") @map("base_currency")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  memberships  Membership[]
  invitations  Invitation[]
  sessions     Session[]
  auditEvents  AuditEvent[]
  accounts     Account[]
  transactions Transaction[]
  transfers    Transfer[]
  recurringRules RecurringTransactionRule[]
  recurringExecutions RecurringTransactionExecution[]
  categories   Category[]
  obligationInstances ObligationInstance[]
  obligationPayments  ObligationPayment[]
  debtSchedules       DebtSchedule[]

  @@map("tenants")
}

model Account {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  name       String
  type       AccountType
  currency   String
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  archivedAt DateTime?   @map("archived_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
  transfersOut Transfer[]    @relation("TransferSource")
  transfersIn  Transfer[]    @relation("TransferDestination")
  recurringRules RecurringTransactionRule[]
  debtSchedules  DebtSchedule[]

  @@index([tenantId])
  @@index([tenantId, archivedAt])
  @@map("accounts")
}

model Membership {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  userId    String         @map("user_id")
  role      MembershipRole @default(owner)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@map("memberships")
}

/// A standing offer to join a household, addressed to an email rather than to a
/// user: a person does not exist in Plinto until the identity provider hands us
/// their first login, so the household that wants them cannot reference a row
/// that is not there yet.
///
/// Deliberately ephemeral. The row is deleted the moment it is accepted or
/// revoked, and the history lives in `audit_events` instead. The alternative —
/// keeping accepted rows and marking them — needs a UNIQUE that only applies to
/// pending ones, and Postgres spells that as a partial index, which Prisma
/// cannot express. A plain UNIQUE over kept rows would forbid ever re-inviting
/// someone who once left.
model Invitation {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  /// Always stored lower-cased by the repository, so the unique below is a
  /// real "one pending invitation per person" and not one per spelling.
  email           String
  role            MembershipRole
  invitedByUserId String         @map("invited_by_user_id")
  expiresAt       DateTime       @map("expires_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  /// Restrict, not Cascade: an invitation records who extended it, and deleting
  /// the inviter must not silently erase that. Users are not deleted today, so
  /// this never fires — it is stated so the intent survives the day they are.
  invitedBy User   @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, email])
  /// Claiming at login looks invitations up by email across every household.
  @@index([email])
  @@map("invitations")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tenantId   String?  @map("tenant_id")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime? @map("last_seen_at")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("sessions")
}

model AuditEvent {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  actorUserId   String?     @map("actor_user_id")
  action        String
  resourceType  String      @map("resource_type")
  resourceId    String?     @map("resource_id")
  source        AuditSource @default(manual)
  correlationId String      @map("correlation_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  metadata      Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("audit_events")
}

model Transaction {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  accountId   String          @map("account_id")
  type        TransactionType
  amountMinor Int             @map("amount_minor")
  currency    String
  description String?
  occurredAt  DateTime        @map("occurred_at")
  transferId  String?         @map("transfer_id")
  categoryId  String?         @map("category_id")
  source      TransactionSource @default(manual)
  recurringRuleId String?     @map("recurring_rule_id")
  recurringPeriod String?     @map("recurring_period")
  idempotencyKey String?      @map("idempotency_key")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  account  Account  @relation(fields: [accountId], references: [id])
  transfer Transfer? @relation(fields: [transferId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule RecurringTransactionRule? @relation(fields: [recurringRuleId], references: [id])
  recurringExecution RecurringTransactionExecution?
  obligationPayment ObligationPayment?

  @@index([tenantId])
  @@index([accountId])
  @@index([transferId])
  @@index([recurringRuleId])
  @@index([tenantId, source])
  @@index([tenantId, categoryId])
  @@map("transactions")
}

model RecurringTransactionRule {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  accountId String      @map("account_id")
  name      String
  type      TransactionType
  amountMinor Int       @map("amount_minor")
  currency  String
  frequency RecurringTransactionFrequency @default(monthly)
  dayOfMonth Int        @map("day_of_month")
  startDate DateTime    @map("start_date")
  status    RecurringRuleStatus @default(active)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  account      Account     @relation(fields: [accountId], references: [id])
  transactions Transaction[]
  executions   RecurringTransactionExecution[]
  obligationInstances ObligationInstance[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("recurring_transaction_rules")
}

model RecurringTransactionExecution {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  ruleId    String      @map("rule_id")
  period    String
  idempotencyKey String  @map("idempotency_key")
  transactionId String   @unique @map("transaction_id")
  status    RecurringExecutionStatus @default(success)
  jobId     String?     @map("job_id")
  createdAt DateTime    @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  rule        RecurringTransactionRule @relation(fields: [ruleId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@unique([ruleId, period])
  @@index([tenantId])
  @@map("recurring_transaction_executions")
}

/// One obligation for one period: what the household is expected to pay, and
/// when. Deliberately stores only facts — expected amount, due date, origin.
/// The lifecycle state (pending / partial / paid / overdue) is DERIVED from
/// the linked payments and the due date, never stored, so it cannot contradict
/// the payments that back it and no job is needed to age instances.
model ObligationInstance {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  sourceType          ObligationSourceType @map("source_type")
  recurringRuleId     String?  @map("recurring_rule_id")
  debtScheduleId      String?  @map("debt_schedule_id")
  period              String
  dueDate             DateTime @map("due_date")
  name                String
  expectedAmountMinor Int      @map("expected_amount_minor")
  currency            String
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant        Tenant                    @relation(fields: [tenantId], references: [id])

  /// Restrict is explicit because Prisma would otherwise infer SetNull for an
  /// optional relation, and nulling `recurringRuleId` violates the
  /// `obligation_instances_source_matches_reference` CHECK, which demands a rule
  /// reference whenever `sourceType` is `recurring_rule`. Rules are archived and
  /// never deleted, so this never fires — it is stated so the schema agrees with
  /// the migration and `migrate dev` reports no drift to "repair".
  recurringRule RecurringTransactionRule? @relation(fields: [recurringRuleId], references: [id], onDelete: Restrict)
  /// Restrict for the same reason as the rule above: a cancelled schedule is
  /// cancelled, never deleted, so the instances it produced keep pointing at
  /// what produced them.
  debtSchedule  DebtSchedule?             @relation(fields: [debtScheduleId], references: [id], onDelete: Restrict)
  payments      ObligationPayment[]

  /// Idempotency of generation. Postgres treats NULLs as distinct, so this
  /// blocks a second instance for the same (rule, period) while still allowing
  /// any number of one-off obligations inside the same period.
  @@unique([recurringRuleId, period])
  /// The same idempotency the rules have: one obligation per (schedule,
  /// period), so re-running generation never duplicates an installment.
  @@unique([debtScheduleId, period])
  @@index([tenantId, period])
  @@map("obligation_instances")
}

/// Links a transaction to the obligation it pays. Several payments may settle
/// one obligation (rent paid in two transfers), but `transactionId` is unique
/// across the whole table, which is what makes "a transaction cannot reconcile
/// two obligations" a guarantee of the engine rather than a check somebody has
/// to remember to write.
model ObligationPayment {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  obligationInstanceId String   @map("obligation_instance_id")
  transactionId        String   @unique @map("transaction_id")
  createdAt            DateTime @default(now()) @map("created_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  obligationInstance ObligationInstance @relation(fields: [obligationInstanceId], references: [id])
  transaction        Transaction        @relation(fields: [transactionId], references: [id])

  @@unique([obligationInstanceId, transactionId])
  @@index([tenantId])
  @@index([obligationInstanceId])
  @@map("obligation_payments")
}

/// A fixed plan of installments against a liability account: what the `ADDI`
/// sheet holds per row. See PRD-007.
///
/// `principalMinor` is the total that will be repaid, interest included — not
/// what the goods cost. Interest is recorded rather than calculated, because
/// retail financing is quoted as a total, a count and an installment, and the
/// rate is never one of the three.
model DebtSchedule {
  id               String             @id @default(uuid())
  tenantId         String             @map("tenant_id")
  accountId        String             @map("account_id")
  name             String
  /// Total to be repaid across every installment.
  principalMinor   Int                @map("principal_minor")
  /// What each installment charges. The last one absorbs the difference, so
  /// the schedule always sums to exactly `principalMinor` — lenders quote
  /// numbers that do not multiply out, and the sheet this replaces is full of
  /// them.
  installmentMinor Int                @map("installment_minor")
  installmentCount Int                @map("installment_count")
  firstDueDate     DateTime           @map("first_due_date")
  currency         String
  status           DebtScheduleStatus @default(active)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
  obligationInstances ObligationInstance[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("debt_schedules")
}

model Transfer {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  sourceAccountId      String    @map("source_account_id")
  destinationAccountId String    @map("destination_account_id")
  sourceAmountMinor    Int       @map("source_amount_minor")
  destinationAmountMinor Int     @map("destination_amount_minor")
  sourceCurrency       String    @map("source_currency")
  destinationCurrency  String    @map("destination_currency")
  fxRate               Decimal?  @map("fx_rate") @db.Decimal(20, 8)
  feeMinor             Int?      @map("fee_minor")
  rateSource           String?   @map("rate_source")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  sourceAccount      Account       @relation("TransferSource", fields: [sourceAccountId], references: [id])
  destinationAccount Account       @relation("TransferDestination", fields: [destinationAccountId], references: [id])
  transactions       Transaction[]

  @@index([tenantId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@map("transfers")
}

model Category {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  name      String
  type      TransactionType
  color     String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]

  @@index([tenantId])
  @@map("categories")
}

enum TransactionType {
  income
  expense
}

enum TransactionSource {
  manual
  job
}

enum RecurringTransactionFrequency {
  monthly
}

/// Single lifecycle state per rule. Replaces the former `active` boolean so
/// that "paused" and "archived" cannot be asserted at the same time, and so a
/// rule may only materialize money under one predicate: status = 'active'.
enum RecurringRuleStatus {
  active
  paused
  archived
}

enum RecurringExecutionStatus {
  success
}

/// Origin of an obligation instance. PRD-007 will add `debt_schedule` together
/// with its own nullable foreign key; a CHECK constraint keeps the declared
/// origin and the populated reference in agreement, so "exactly one origin" is
/// enforced by the database rather than by convention.
enum ObligationSourceType {
  recurring_rule
  manual
  /// An installment of a debt schedule (PRD-007).
  debt_schedule
}

/// Only the two states somebody decides. Settlement is derived from the
/// schedule's own installments and their payments, the same way obligation
/// status is derived from its payments — a stored "settled" could contradict
/// them, and nothing in the system would be able to say which to believe.
enum DebtScheduleStatus {
  active
  cancelled
}

enum MembershipRole {
  owner
  member
  viewer
}

enum AccountType {
  cash
  bank
  credit
  savings
  /// Money owed to a lender: a loan taken, or a purchase financed in
  /// installments. Its balance is normally negative — what is still owed.
  /// See PRD-007.
  debt
}

enum AuditSource {
  manual
  job
  import
}
