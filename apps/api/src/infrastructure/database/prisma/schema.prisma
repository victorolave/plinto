datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  idpSub    String   @unique @map("idp_sub")
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Tenant {
  id           String       @id @default(uuid())
  name         String
  baseCurrency String       @default("COP") @map("base_currency")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  memberships  Membership[]
  sessions     Session[]
  auditEvents  AuditEvent[]
  accounts     Account[]
  transactions Transaction[]
  transfers    Transfer[]
  recurringRules RecurringTransactionRule[]
  recurringExecutions RecurringTransactionExecution[]
  categories   Category[]

  @@map("tenants")
}

model Account {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  name       String
  type       AccountType
  currency   String
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  archivedAt DateTime?   @map("archived_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
  transfersOut Transfer[]    @relation("TransferSource")
  transfersIn  Transfer[]    @relation("TransferDestination")
  recurringRules RecurringTransactionRule[]

  @@index([tenantId])
  @@index([tenantId, archivedAt])
  @@map("accounts")
}

model Membership {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  userId    String         @map("user_id")
  role      MembershipRole @default(owner)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@map("memberships")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tenantId   String?  @map("tenant_id")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime? @map("last_seen_at")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("sessions")
}

model AuditEvent {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  actorUserId   String?     @map("actor_user_id")
  action        String
  resourceType  String      @map("resource_type")
  resourceId    String?     @map("resource_id")
  source        AuditSource @default(manual)
  correlationId String      @map("correlation_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  metadata      Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("audit_events")
}

model Transaction {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  accountId   String          @map("account_id")
  type        TransactionType
  amountMinor Int             @map("amount_minor")
  currency    String
  description String?
  occurredAt  DateTime        @map("occurred_at")
  transferId  String?         @map("transfer_id")
  categoryId  String?         @map("category_id")
  source      TransactionSource @default(manual)
  recurringRuleId String?     @map("recurring_rule_id")
  recurringPeriod String?     @map("recurring_period")
  idempotencyKey String?      @map("idempotency_key")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  account  Account  @relation(fields: [accountId], references: [id])
  transfer Transfer? @relation(fields: [transferId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule RecurringTransactionRule? @relation(fields: [recurringRuleId], references: [id])
  recurringExecution RecurringTransactionExecution?

  @@index([tenantId])
  @@index([accountId])
  @@index([transferId])
  @@index([recurringRuleId])
  @@index([tenantId, source])
  @@index([tenantId, categoryId])
  @@map("transactions")
}

model RecurringTransactionRule {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  accountId String      @map("account_id")
  name      String
  type      TransactionType
  amountMinor Int       @map("amount_minor")
  currency  String
  frequency RecurringTransactionFrequency @default(monthly)
  dayOfMonth Int        @map("day_of_month")
  startDate DateTime    @map("start_date")
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  account      Account     @relation(fields: [accountId], references: [id])
  transactions Transaction[]
  executions   RecurringTransactionExecution[]

  @@index([tenantId])
  @@index([tenantId, active])
  @@map("recurring_transaction_rules")
}

model RecurringTransactionExecution {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  ruleId    String      @map("rule_id")
  period    String
  idempotencyKey String  @map("idempotency_key")
  transactionId String   @unique @map("transaction_id")
  status    RecurringExecutionStatus @default(success)
  jobId     String?     @map("job_id")
  createdAt DateTime    @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  rule        RecurringTransactionRule @relation(fields: [ruleId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@unique([ruleId, period])
  @@index([tenantId])
  @@map("recurring_transaction_executions")
}

model Transfer {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  sourceAccountId      String    @map("source_account_id")
  destinationAccountId String    @map("destination_account_id")
  sourceAmountMinor    Int       @map("source_amount_minor")
  destinationAmountMinor Int     @map("destination_amount_minor")
  sourceCurrency       String    @map("source_currency")
  destinationCurrency  String    @map("destination_currency")
  fxRate               Decimal?  @map("fx_rate") @db.Decimal(20, 8)
  feeMinor             Int?      @map("fee_minor")
  rateSource           String?   @map("rate_source")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  sourceAccount      Account       @relation("TransferSource", fields: [sourceAccountId], references: [id])
  destinationAccount Account       @relation("TransferDestination", fields: [destinationAccountId], references: [id])
  transactions       Transaction[]

  @@index([tenantId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@map("transfers")
}

model Category {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  name      String
  type      TransactionType
  color     String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]

  @@index([tenantId])
  @@map("categories")
}

enum TransactionType {
  income
  expense
}

enum TransactionSource {
  manual
  job
}

enum RecurringTransactionFrequency {
  monthly
}

enum RecurringExecutionStatus {
  success
}

enum MembershipRole {
  owner
  member
  viewer
}

enum AccountType {
  cash
  bank
  credit
  savings
}

enum AuditSource {
  manual
  job
  import
}
